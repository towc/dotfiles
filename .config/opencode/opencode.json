{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["/home/user/git/github/towc/opencode-plugin-boops"],
  "enabled_providers": ["opencode"],
  "permission": {
    "*": "ask",
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "npx tsc *": "allow",
      "swaymsg *": "allow",
      "jq *": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow"
    },
    "edit": {
      "*": "ask",
      "/tmp/**": "allow",
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "codesearch": "allow"
  }
}
